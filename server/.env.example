# ===== Servidor =====
HOST=127.0.0.1
PORT=8787
# Opcional. Se preencher, cole o mesmo valor no campo "Token" do painel da extensão.
SERVER_TOKEN=

# ===== Transcrição ao vivo (Deepgram) =====
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ===== LLM rápido: traduz e extrai afirmações checáveis =====
# Qualquer API compatível com OpenAI serve (Gemini, OpenAI, OpenRouter...).
# Exemplo com Gemini (confira no Google AI Studio o nome do modelo flash mais recente):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# ===== Hermes Agent: faz a pesquisa e o veredito =====
# Endereço do API server do Hermes (porta padrão 8642).
HERMES_BASE_URL=http://127.0.0.1:8642/v1
# Mesmo valor de API_SERVER_KEY que você colocou em ~/.hermes/.env
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
# Quantas checagens rodam ao mesmo tempo (o Hermes limita a 10 por padrão)
HERMES_CONCURRENCY=3
HERMES_TIMEOUT_MS=180000
# Máximo de afirmações esperando na fila; as de menor prioridade e mais antigas são descartadas
MAX_QUEUE=30
